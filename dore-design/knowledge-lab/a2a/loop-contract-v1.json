  "peer_research": {
    "self_research_first": true,
    "conversation_activated": true,
    "blocking": false,
    "transport": "dore.mail.v2 -> GitHub durable A2A state -> ChatGPT conversation observation -> chatgpt-to-dore durable mailbox",
    "outbound_component": "local/dore-local/research_executor.py",
    "inbound_component": "local/dore-local/peer_research_bridge.py",
    "rule": "Doré may publish a peer request after self-research is insufficient, but must checkpoint it and continue another information-gaining local/free/OSS action while ChatGPT is absent.",
    "truthfulness": "PEER_RESEARCH_QUEUED is not KNOWLEDGE_RETURNED; only a provenance-bearing matching research_id reply may advance the peer artifact."
  },
  "storybook_learning_rule": "reference -> hypothesis -> story -> build -> real-browser tests -> visual/responsive observation -> verify/reject -> skill/memory -> next hypothesis",
  "promotion_rule": "candidate -> experiment -> verified -> shared-learning/failure-memory/skill promotion -> resume exact parent",
  "human_gate_rule": "Only non-proxyable OS/account/payment approval or a decision changing product intent may stop for a human."
