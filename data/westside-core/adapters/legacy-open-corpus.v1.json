    {"id":"openbible-bible-geocoding-data","promoteAs":["place","map","geo","scripture-relation"]},
    {"id":"stepbible-data","promoteAs":["biblical-person","place","lexicon","scripture-relation","language-resource"]},
    {"id":"fitzwilliam-collection-raw-data","promoteAs":["art-metadata","image-pointer"]},
    {"id":"national-gallery-of-art-opendata","promoteAs":["art-metadata","image-pointer"]},
    {"id":"mplus-collection-data","promoteAs":["art-metadata","design-metadata"]}
