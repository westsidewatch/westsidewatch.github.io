{
  "version": 1,
  "viewports": [
    {
      "name": "desktop-16x9",
      "width": 1920,
      "height": 1080
    },
    {
      "name": "desktop-16x10",
      "width": 1680,
      "height": 1050
    },
    {
      "name": "user-reference",
      "width": 1648,
      "height": 927
    },
    {
      "name": "laptop",
      "width": 1440,
      "height": 900
    },
    {
      "name": "desktop-compact",
      "width": 1024,
      "height": 768
    },
    {
      "name": "breakpoint-desktop",
      "width": 901,
      "height": 800
    },
    {
      "name": "breakpoint-mobile",
      "width": 900,
      "height": 800
    }
  ],
  "contracts": [
    {
      "id": "candidate01",
      "path": "/candidate01/walk-worship.html",
      "probe": "candidate01",
      "required": true,
      "states": [
        {
          "name": "hover-left",
          "target": ".products__grid .product:not([data-source=\"ONE\"]):nth-child(-n+4)"
        },
        {
          "name": "hover-right",
          "target": ".products__grid .product:not([data-source=\"ONE\"]):nth-child(n+5)"
        },
        {
          "name": "reduced-motion",
          "reducedMotion": "reduce"
        }
      ],
      "rules": {
        "geometry": {
          "align": [
            "preview.top=smallGroup.top",
            "preview.bottom=smallGroup.bottom"
          ],
          "tolerancePx": 2
        },
        "aspectRatio": {
          "preview": 1.6,
          "cards": 1.6,
          "tolerance": 0.01
        },
        "motion": {
          "normal": "present",
          "reduced": "none"
        }
      }
    },
    {
      "id": "homepage-award-polish",
      "path": "/",
      "probe": "homepage",
      "required": true,
      "states": [
        {
          "name": "default"
        },
        {
          "name": "reduced-motion",
          "reducedMotion": "reduce"
        }
      ],
      "rules": {
        "geometry": {
          "tolerancePx": 2
        },
        "motion": {
          "normal": "present",
          "reduced": "none"
        }
      }
    }
  ],
  "defaults": {
    "tolerancePx": 2,
    "aspectRatioTolerance": 0.01,
    "desktopMinWidth": 901
  },
  "schema": {
    "contractRequired": [
      "id",
      "path",
      "probe",
      "required"
    ],
    "supportedRules": [
      "geometry",
      "aspectRatio",
      "motion"
    ],
    "supportedStates": [
      "target",
      "reducedMotion"
    ]
  }
}
