{
  "version": "0.2",
  "capability": "video-acquisition",
  "execution": "local-first",
  "commands": ["probe", "formats", "download"],
  "routing": [
    {"match": "webpage or ordinary media URL", "engine": "yt-dlp"},
    {"match": "direct .m3u8/.mpd/.ism/manifest URL", "engine": "N_m3u8DL-RE"}
  ],
  "primary_engine": "yt-dlp",
  "stream_fallback": {"engine": "N_m3u8DL-RE", "status": "active", "protocols": ["HLS", "DASH", "MSS"]},
  "policy": {"allowed": "public or authorized media", "drm_bypass": false},
  "probe_fields": ["engine","id","title","webpage_url","duration","is_live","thumbnail","subtitles","automatic_captions","formats"]
}
