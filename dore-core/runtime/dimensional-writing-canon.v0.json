{
  "schema": "dore.dimensional-writing-canon.v0",
  "authority": "westside-writing-canon",
  "purpose": "Compact executable canon for Doré co-writing. This is not a style imitation prompt.",
  "authorAuthority": {
    "manuscript": true,
    "thesis": true,
    "theologicalInsight": true,
    "maySilentlyRewrite": false
  },
  "loop": ["read-manuscript", "find-center", "identify-gaps", "choose-dimension", "research-deepen", "make-perceptible", "propose", "judge", "return-to-body", "reread"],
  "movement": ["discover", "deepen", "expand", "perceive", "wander", "latent-line", "converge", "christ"],
  "principles": [
    "scene-action-before-explanation",
    "consequential-detail",
    "no-scene-without-evidence",
    "person-as-aperture-not-example",
    "structural-absence",
    "depth-before-analogy",
    "located-witnessed-observer",
    "resist-premature-coherence",
    "structural-echo",
    "internal-world",
    "judgment-grows-from-narrative",
    "truth-floor",
    "verbs-carry-scene",
    "unpack-modifiers",
    "connector-restraint",
    "low-temperature-surface-high-interior-tension",
    "semantic-pressure",
    "kinetic-arc",
    "repetition-must-accumulate-meaning",
    "latent-prosody",
    "breath-follows-thought",
    "paragraph-carries-complete-thought-movement",
    "line-break-follows-meaning-not-manufactured-rhythm",
    "concentration-must-be-earned-by-material"
  ],
  "dimensionalSources": ["scripture", "original-language", "geography", "history", "material-culture", "ritual", "law", "manuscripts", "reception-history", "poetry", "literature", "art", "sound", "maps"],
  "diagnosticLexicon": {
    "connectives": ["但是", "但", "然而", "可是", "所以", "于是", "於是", "其实", "其實", "原来", "原來", "到了这里", "到了這裡", "这时候", "這時候", "换句话说", "換句話說", "值得注意的是", "更重要的是"],
    "adverbs": ["突然", "终于", "終於", "真正", "仍然", "甚至", "恰恰", "其实", "其實", "已经", "已經", "一直"]
  },
  "judgeGates": ["thesis", "author-voice", "return-line", "evidence", "media-participates-in-argument", "reader-burden", "paragraph-integrity", "semantic-pressure", "no-premature-thesis-reveal"],
  "rule": "Diagnostics expose risk; they never mechanically rewrite authorial prose. Semantic judgment decides whether a flagged form is earned."
}