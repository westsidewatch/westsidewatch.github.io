{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "one.visual-manifest.schema.json",
  "title": "ONE Chapter Visual Manifest",
  "type": "object",
  "required": ["schemaVersion", "chapters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "chapters": {
      "type": "array",
      "items": { "$ref": "#/$defs/chapter" }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "required": ["assetId", "path", "kind", "orientation", "locked"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["dore", "one-studio"] },
        "orientation": { "enum": ["portrait", "landscape", "square"] },
        "locked": { "const": true },
        "doreTitle": { "type": ["string", "null"] },
        "originalProvenance": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"] }
      },
      "allOf": [{
        "if": { "properties": { "kind": { "const": "dore" } } },
        "then": { "required": ["doreTitle", "originalProvenance"] }
      }]
    },
    "chapter": {
      "type": "object",
      "required": ["chapterId", "book", "chapter", "status", "cover", "illustrations", "themeVerse", "layout"],
      "properties": {
        "chapterId": { "type": "string", "pattern": "^[A-Z0-9]+\\.[0-9]+$" },
        "book": { "type": "string", "minLength": 1 },
        "chapter": { "type": "integer", "minimum": 1 },
        "status": { "const": "LOCKED_CALLABLE" },
        "reuseClass": { "enum": ["DORÉ-ORIGINAL", "DORÉ-REUSE-EVENT", "DORÉ-REUSE-TEXT", "DORÉ-REUSE-IMAGE-MEANING", "ONE-STUDIO"] },
        "cover": { "$ref": "#/$defs/asset" },
        "illustrations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/asset" } },
        "themeVerse": {
          "type": "object",
          "required": ["reference", "text"],
          "properties": {
            "reference": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
          }
        },
        "layout": {
          "type": "object",
          "required": ["cover", "illustration"],
          "properties": {
            "cover": { "const": "portrait-book-cover-template" },
            "illustration": { "enum": ["landscape-image-with-verse", "portrait-image-with-side-verse", "multi-image-editorial-spread"] }
          }
        }
      }
    }
  }
}
