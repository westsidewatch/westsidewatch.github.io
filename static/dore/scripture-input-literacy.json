    {"code":"MRK","aliases":["可","馬可","马可","馬可福音","马可福音","Mk","Mark"]},
    {"code":"LUK","aliases":["路","路加","路加福音","Lk","Luke"]},
    {"code":"JHN","aliases":["約","约","約翰","约翰","約翰福音","约翰福音","Jn","John"]},
    {"code":"ACT","aliases":["徒","使徒行傳","使徒行传","Acts"]},
    {"code":"ROM","aliases":["羅","罗","羅馬","罗马","羅馬書","罗马书","Rom","Romans"]},
    {"code":"1CO","aliases":["林前","哥前","哥林多前書","哥林多前书","1Cor","1 Cor","1Corinthians"]},
    {"code":"2CO","aliases":["林後","林后","哥後","哥后","哥林多後書","哥林多后书","2Cor","2 Cor","2Corinthians"]},
    {"code":"GAL","aliases":["加","加拉太書","加拉太书","Gal","Galatians"]},
    {"code":"EPH","aliases":["弗","以弗所書","以弗所书","Eph","Ephesians"]},
    {"code":"PHP","aliases":["腓","腓立比書","腓立比书","Phil","Philippians"]},
    {"code":"COL","aliases":["西","歌羅西書","歌罗西书","Col","Colossians"]},
    {"code":"1TH","aliases":["帖前","帖撒羅尼迦前書","帖撒罗尼迦前书","1Thess","1 Thess","1Thessalonians"]},
    {"code":"2TH","aliases":["帖後","帖后","帖撒羅尼迦後書","帖撒罗尼迦后书","2Thess","2 Thess","2Thessalonians"]},
    {"code":"1TI","aliases":["提前","提摩太前書","提摩太前书","1Tim","1 Tim","1Timothy"]},
    {"code":"2TI","aliases":["提後","提后","提摩太後書","提摩太后书","2Tim","2 Tim","2Timothy"]},
    {"code":"TIT","aliases":["多","提多書","提多书","Tit","Titus"]},
    {"code":"PHM","aliases":["門","门","腓利門書","腓利门书","Phlm","Philemon"]},
    {"code":"HEB","aliases":["來","来","希伯來書","希伯来书","Heb","Hebrews"]},
    {"code":"JAS","aliases":["雅","雅各書","雅各书","Jas","James"]},
    {"code":"1PE","aliases":["彼前","彼得前書","彼得前书","1Pet","1 Pet","1Peter"]},
    {"code":"2PE","aliases":["彼後","彼后","彼得後書","彼得后书","2Pet","2 Pet","2Peter"]},
    {"code":"1JN","aliases":["約一","约一","約壹","约壹","約翰一書","约翰一书","1Jn","1 John"]},
    {"code":"2JN","aliases":["約二","约二","約貳","约贰","約翰二書","约翰二书","2Jn","2 John"]},
    {"code":"3JN","aliases":["約三","约三","約參","约叁","約翰三書","约翰三书","3Jn","3 John"]},
    {"code":"JUD","aliases":["猶","犹","猶大書","犹大书","Jude"]},
    {"code":"REV","aliases":["啟","启","啟示錄","启示录","Rev","Revelation"]}
  ],
  "training_examples": [
    {"input":"羅馬書3：12-16","expect":["ROM",3,12,16]},
    {"input":"林前 8:9-15","expect":["1CO",8,9,15]},
    {"input":"賽三第四節","expect":["ISA",3,4,4]},
    {"input":"帖後3章八節到十節","expect":["2TH",3,8,10]},
    {"input":"帖後三","expect":["2TH",3]},
    {"input":"帖後3","expect":["2TH",3]},
    {"input":"創世紀2:5-9","expect":["GEN",2,5,9]},
    {"input":"帖後3：15-19 創世紀2:5-9","expect_multi":2}
  ],
  "graduation_rule": "Pass common aliases, number forms, chapter/verse/range notation, multiple-reference queries, regression safety, and blind combinations not copied from training examples."
}
