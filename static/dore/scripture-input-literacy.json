    {"code":"NAM","aliases":["鴻","鸿","那鴻書","那鸿书","Nah","Nahum"]},
    {"code":"HAB","aliases":["哈","哈巴谷書","哈巴谷书","Hab","Habakkuk"]},
    {"code":"ZEP","aliases":["番","西番雅書","西番雅书","Zeph","Zephaniah"]},
    {"code":"HAG","aliases":["該","该","哈該書","哈该书","Hag","Haggai"]},
    {"code":"ZEC","aliases":["亞","亚","撒迦利亞書","撒迦利亚书","Zech","Zechariah"]},
