    {"code":"JER","aliases":["耶","耶利米書","耶利米书","Jer","Jeremiah"]},
    {"code":"LAM","aliases":["哀","耶利米哀歌","Lam","Lamentations"]},
    {"code":"EZK","aliases":["結","结","以西結書","以西结书","Ezek","Ezekiel"]},
    {"code":"DAN","aliases":["但","但以理書","但以理书","Dan","Daniel"]},
    {"code":"HOS","aliases":["何","何西阿書","何西阿书","Hos","Hosea"]},
