{
  "schema": "dore.scripture-search-input-literacy.v1",
  "milestone": "SCRIPTURE_SEARCH_INPUT_LITERACY_1",
  "purpose": "Teach Doré the ordinary ways people actually type Bible references. This corpus is maintainable evidence, not a frozen parser specification.",
  "principles": [
    "Recognize reference intent before demanding canonical formatting.",
    "Common abbreviations and notation are input literacy, not reasoning tasks.",
    "Multiple references in one query are normal.",
    "New stable real-world patterns may be proposed later by Doré, tested, then added to this corpus."
  ],
  "separators": {
    "chapter_verse": [":", "：", ".", "．"],
    "range": ["-", "－", "–", "—", "~", "～", "至", "到"],
    "multi": [";", "；", ",", "，", "、", "newline", "book-boundary whitespace"]
  },
  "number_forms": ["arabic", "traditional_chinese", "simplified_chinese"],
  "books": [
    {"code":"GEN","aliases":["創","创","創世記","创世记","創世紀","创世纪","Gen","Genesis"]},
    {"code":"EXO","aliases":["出","出埃及記","出埃及记","Exod","Exo","Exodus"]},
    {"code":"LEV","aliases":["利","利未記","利未记","Lev","Leviticus"]},
    {"code":"NUM","aliases":["民","民數記","民数记","Num","Numbers"]},
    {"code":"DEU","aliases":["申","申命記","申命记","Deut","Deuteronomy"]},
    {"code":"JOS","aliases":["書","书","書亞","书亚","約書亞記","约书亚记","Josh","Joshua"]},
    {"code":"JDG","aliases":["士","士師記","士师记","Judg","Judges"]},
    {"code":"RUT","aliases":["得","路得記","路得记","Ruth"]},
    {"code":"1SA","aliases":["撒上","撒母耳記上","撒母耳记上","1Sam","1 Sam","1Samuel"]},
    {"code":"2SA","aliases":["撒下","撒母耳記下","撒母耳记下","2Sam","2 Sam","2Samuel"]},
    {"code":"1KI","aliases":["王上","列王紀上","列王纪上","1Kgs","1 Kings"]},
    {"code":"2KI","aliases":["王下","列王紀下","列王纪下","2Kgs","2 Kings"]},
    {"code":"1CH","aliases":["代上","歷代志上","历代志上","1Chr","1 Chronicles"]},
    {"code":"2CH","aliases":["代下","歷代志下","历代志下","2Chr","2 Chronicles"]},
    {"code":"EZR","aliases":["拉","以斯拉記","以斯拉记","Ezra"]},
    {"code":"NEH","aliases":["尼","尼希米記","尼希米记","Neh","Nehemiah"]},
    {"code":"EST","aliases":["斯","以斯帖記","以斯帖记","Esth","Esther"]},
    {"code":"JOB","aliases":["伯","約伯記","约伯记","Job"]},
    {"code":"PSA","aliases":["詩","诗","詩篇","诗篇","Ps","Psa","Psalm","Psalms"]},
    {"code":"PRO","aliases":["箴","箴言","Prov","Proverbs"]},
    {"code":"ECC","aliases":["傳","传","傳道書","传道书","Eccl","Ecclesiastes"]},
    {"code":"SNG","aliases":["歌","雅歌","Song","Song of Songs","Song of Solomon"]},
