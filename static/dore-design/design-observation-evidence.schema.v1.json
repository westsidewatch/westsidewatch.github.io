{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dore.design-observation-evidence.v1",
  "title": "Doré Design Observation Evidence Envelope v1",
  "description": "Canonical evidence envelope consumed by Doré Design Intelligence. Observation is evidence, never design authority and never an automatic promotion path.",
  "type": "object",
  "required": ["schema", "id", "source", "observations", "provenance", "authority"],
  "properties": {
    "schema": {"const": "dore.design-observation-evidence.v1"},
    "id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"enum": ["url", "render", "screenshot", "scan", "candidate", "artifact"]},
        "locator": {"type": "string", "minLength": 1},
        "capturedAt": {"type": ["string", "null"]},
        "viewport": {
          "type": ["object", "null"],
          "properties": {"width": {"type": "number"}, "height": {"type": "number"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "observations": {
      "type": "object",
      "required": ["visualFacts", "componentGrammar", "compositionGrammar", "editorialGrammar", "motionGrammar", "responsiveBehavior"],
      "properties": {
        "visualFacts": {"type": "object", "description": "Observed typography, color, spacing, geometry, borders, elevation and grid facts."},
        "componentGrammar": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "compositionGrammar": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "editorialGrammar": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "motionGrammar": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "responsiveBehavior": {"type": "array", "items": {"$ref": "#/$defs/claim"}},
        "inferredRationale": {"type": "array", "items": {"$ref": "#/$defs/inference"}}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["evidenceRefs", "method"],
      "properties": {
        "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "method": {"type": "array", "minItems": 1, "items": {"enum": ["dom", "css", "computed-style", "render", "vision", "human", "motion-capture", "document-analysis"]}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["class", "mayPromoteCanonical", "requiresBeautifulGate"],
      "properties": {
        "class": {"const": "observational-evidence"},
        "mayPromoteCanonical": {"const": false},
        "requiresBeautifulGate": {"const": true},
        "historicalAuthority": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    },
    "exports": {
      "type": "object",
      "properties": {
        "designMd": {"type": "boolean", "default": false},
        "cssVariables": {"type": "boolean", "default": false},
        "tailwind": {"type": "boolean", "default": false},
        "dtcgTokens": {"type": "boolean", "default": false}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["statement", "confidence", "evidenceRefs"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "evidenceRefs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "inference": {
      "allOf": [
        {"$ref": "#/$defs/claim"},
        {"type": "object", "properties": {"status": {"const": "inference-not-fact"}}, "required": ["status"]}
      ]
    }
  },
  "additionalProperties": false
}
