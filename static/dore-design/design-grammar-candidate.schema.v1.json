{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"dore.design-grammar-candidate.v1",
  "type":"object",
  "required":["schema","id","grammar","evidence","authority"],
  "properties":{
    "schema":{"const":"dore.design-grammar-candidate.v1"},
    "id":{"type":"string","minLength":1},
    "grammar":{"type":"object","required":["statement","layer"],"properties":{"statement":{"type":"string","minLength":1},"layer":{"enum":["component","composition","editorial","motion","responsive","temporal"]},"transferIntent":{"type":["string","null"]}},"additionalProperties":true},
    "evidence":{"type":"object","required":["sourceIds","evidenceRefs","distinction"],"properties":{"sourceIds":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},"evidenceRefs":{"type":"array","minItems":1,"items":{"type":"string"}},"distinction":{"const":"inference-from-observational-evidence"},"confidence":{"type":"number","minimum":0,"maximum":1}},"additionalProperties":true},
    "mutation":{"type":"object","properties":{"novelty":{"type":["number","null"],"minimum":0,"maximum":1},"continuity":{"type":["number","null"],"minimum":0,"maximum":1},"sourceConcentration":{"type":["number","null"],"minimum":0,"maximum":1}},"additionalProperties":true},
    "authority":{"type":"object","required":["class","mayPromoteCanonical","requiresRealRender","requiresBeautifulGate","requiresHumanAuthority"],"properties":{"class":{"const":"design-candidate"},"mayPromoteCanonical":{"const":false},"requiresRealRender":{"const":true},"requiresBeautifulGate":{"const":true},"requiresHumanAuthority":{"const":true}},"additionalProperties":false}
  },
  "additionalProperties":true
}
