{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dore.skill-growth.observation.v0",
  "title": "Doré Skill Growth Observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "source", "signal", "scope", "authority", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["correction", "failure", "friction", "success-pattern", "capability-gap", "transfer-signal"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "eventRef"],
      "properties": {
        "surface": {"type": "string", "minLength": 1},
        "eventRef": {"type": "string", "minLength": 1},
        "consumer": {"type": "string"}
      }
    },
    "signal": {"type": "string", "minLength": 1},
    "scope": {"enum": ["local", "skill", "skill-family", "cross-capability", "core-principle"]},
    "relatedCapabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "recurrenceKey": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "string"}},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mayPromoteCanonical", "mayRewriteHumanAuthority"],
      "properties": {
        "mayPromoteCanonical": {"const": false},
        "mayRewriteHumanAuthority": {"const": false}
      }
    },
    "status": {"enum": ["observed", "clustered", "candidate", "dismissed", "superseded"]}
  }
}
