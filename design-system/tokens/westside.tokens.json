{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "meta": {
    "name": "Westside Design OS",
    "version": "1.0.0",
    "authority": "single-source",
    "scope": "site-and-tools"
  },
  "font": {
    "display-en": {
      "$type": "fontFamily",
      "$value": [
        "Bodoni Moda",
        "serif"
      ]
    },
    "display-en-sc": {
      "$type": "fontFamily",
      "$value": [
        "Bodoni Moda SC",
        "Bodoni Moda",
        "serif"
      ]
    },
    "display-zh": {
      "$type": "fontFamily",
      "$value": [
        "Chiron Hei HK WS",
        "Noto Sans TC",
        "sans-serif"
      ]
    },
    "reading-zh": {
      "$type": "fontFamily",
      "$value": [
        "Chiron Hei HK WS",
        "Noto Sans TC",
        "sans-serif"
      ]
    }
  },
  "weight": {
    "air": {
      "$type": "fontWeight",
      "$value": 200
    },
    "standard": {
      "$type": "fontWeight",
      "$value": 400
    },
    "anchor": {
      "$type": "fontWeight",
      "$value": 600
    },
    "section": {
      "$type": "fontWeight",
      "$value": 900
    }
  },
  "color": {
    "paper": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.9803921568627451,
          0.9764705882352941,
          0.9607843137254902
        ]
      }
    },
    "ink": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.1451,
          0.1451,
          0.1451
        ]
      }
    },
    "water": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.3569,
          0.5608,
          0.6588
        ]
      }
    },
    "first-light": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6353,
          0.5294,
          0.1647
        ]
      }
    },
    "olive": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.451,
          0.5412,
          0.3529
        ]
      }
    },
    "harvest": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.7216,
          0.5804,
          0.2902
        ]
      }
    },
    "crimson": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.6314,
          0.302,
          0.3412
        ]
      }
    }
  },
  "scope": {
    "site": {
      "$type": "string",
      "$value": "site"
    },
    "tool": {
      "$type": "string",
      "$value": "tool"
    },
    "component": {
      "$type": "string",
      "$value": "component"
    }
  },
  "overrides": {
    "olive": {
      "--ws-weight-zh-air": "200",
      "--ws-olive-speaker-name-weight": "var(--ws-weight-zh-air)",
      "--ws-olive-layer-zh-weight": "var(--ws-weight-zh-air)"
    },
    "one": {
      "--ws-interaction": "var(--ws-pale-gold)"
    }
  },
  "typeScale": {
    "editorial-hero-en": {
      "$type": "dimension",
      "$value": "clamp(4.5rem,7vw + 1rem,10rem)"
    },
    "editorial-hero-zh": {
      "$type": "dimension",
      "$value": "clamp(2.25rem,3.5vw + .65rem,5rem)"
    },
    "editorial-chapter-en": {
      "$type": "dimension",
      "$value": "clamp(3.25rem,4.7vw + .85rem,7rem)"
    },
    "editorial-chapter-zh": {
      "$type": "dimension",
      "$value": "clamp(2rem,2.8vw + .7rem,4.25rem)"
    },
    "editorial-article-en": {
      "$type": "dimension",
      "$value": "clamp(3.5rem,5.2vw + .8rem,8rem)"
    },
    "editorial-article-zh": {
      "$type": "dimension",
      "$value": "clamp(2.5rem,3vw + .9rem,5rem)"
    },
    "editorial-feature-en": {
      "$type": "dimension",
      "$value": "clamp(2.375rem,3.2vw + .8rem,5rem)"
    },
    "editorial-feature-zh": {
      "$type": "dimension",
      "$value": "clamp(1.875rem,2vw + .75rem,3.125rem)"
    },
    "editorial-subhead-zh": {
      "$type": "dimension",
      "$value": "clamp(1.5rem,1.4vw + .85rem,2.5rem)"
    },
    "editorial-standfirst-zh": {
      "$type": "dimension",
      "$value": "clamp(1.375rem,1.05vw + .9rem,2.25rem)"
    },
    "editorial-byline-zh": {
      "$type": "dimension",
      "$value": "clamp(1.125rem,.6vw + .85rem,1.5625rem)"
    },
    "editorial-contents-zh": {
      "$type": "dimension",
      "$value": "clamp(1.25rem,.75vw + .95rem,1.875rem)"
    }
  }
}
